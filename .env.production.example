# Copy to .env.production on the server and fill in. Never commit the real file.

# Public hostname for the API. Point an A record at the server's IP before the
# first `up` — Caddy requests the HTTPS certificate for this name on startup.
API_DOMAIN=api.example.com

ENV=production
VERSION_NAME=v1
APP_NAME=Jarvis API
# The mobile app is not a browser, so CORS does not apply to it.
ALLOWED_ORIGINS=

# DB_HOST / DB_PORT are set by docker-compose.prod.yml; only credentials here.
DB_USER=jarvis
DB_PASSWORD=change-me-to-a-long-random-password
DB_NAME=jarvis

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=replace-with-your-supabase-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=property-files

ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-5
ANTHROPIC_SCAN_MODEL=claude-opus-5
